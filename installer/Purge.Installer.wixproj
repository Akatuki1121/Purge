<Project Sdk="WixToolset.Sdk/6.0.1">

  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <ProductVersion Condition="'$(ProductVersion)'==''">0.1.0</ProductVersion>
    <!-- 配布用の既定値はhigh(#45)。ローカル検証時のビルド高速化用に
         -p:MsiCompressionLevel=none 等で上書き可能(#55)。release.ymlは指定しないため
         配布物への影響はない。 -->
    <MsiCompressionLevel Condition="'$(MsiCompressionLevel)'==''">high</MsiCompressionLevel>
    <DefineConstants>PublishDir=$(MSBuildProjectDirectory)\..\publish\Purge;ProductVersion=$(ProductVersion);MsiCompressionLevel=$(MsiCompressionLevel)</DefineConstants>
    <Cultures Condition="'$(Cultures)'==''">ja-JP;en-US</Cultures>
    <SuppressIces>ICE43;ICE57;ICE69</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.1" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(Cultures)'=='' OR $(Cultures.Contains('ja-JP'))">
    <WxlFile Include="Loc\ja-jp.wxl" />
  </ItemGroup>
  <ItemGroup Condition="'$(Cultures)'=='' OR $(Cultures.Contains('en-US'))">
    <WxlFile Include="Loc\en-us.wxl" />
  </ItemGroup>

</Project>
