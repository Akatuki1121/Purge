<ui:FluentWindow x:Class="UninstallTool.UI.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="ライセンス認証" Height="380" Width="560"
        ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ライセンス認証"/>

        <ui:InfoBar x:Name="StatusInfoBar" Grid.Row="1" Margin="14,10,14,8" IsOpen="True" IsClosable="False"
                    Severity="Informational" Title="無料版で利用中"
                    Message="Pro版のライセンスキーをお持ちの場合は、下の欄に貼り付けて「認証する」を押してください。"/>

        <StackPanel Grid.Row="2" Margin="14,0,14,10">
            <TextBlock Text="ライセンスキー" FontWeight="Bold" Margin="0,0,0,6"/>
            <ui:TextBox x:Name="LicenseKeyTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas" FontSize="11" Height="90"
                        PlaceholderText="購入時にお送りしたライセンスキーを貼り付けてください"/>

            <TextBlock x:Name="LicenseDetailText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="Gray" FontSize="12"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
            <ui:Button x:Name="PurchaseButton" Content="購入はこちら" Icon="{ui:SymbolIcon Cart24}"
                       Click="PurchaseButton_Click" HorizontalAlignment="Left"/>
            <ui:Button x:Name="DeactivateButton" Content="ライセンスを解除" Margin="16,0,0,0" Click="DeactivateButton_Click"/>
            <ui:Button x:Name="ActivateButton" Content="認証する" Appearance="Primary"
                       Icon="{ui:SymbolIcon CheckmarkCircle24}" Margin="8,0,0,0" Click="ActivateButton_Click"/>
            <ui:Button x:Name="CloseButton" Content="閉じる" Margin="8,0,0,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
