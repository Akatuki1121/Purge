<ui:FluentWindow x:Class="UninstallTool.UI.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="不具合を報告" Height="650" Width="760"
        ExtendsContentIntoTitleBar="True" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="不具合を報告"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14,10,14,10">
                <ui:InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                            Title="GitHub Issueとして報告"
                            Message="入力内容に環境情報と直近の操作ログを添えて、GitHubのIssue作成ページを開きます。投稿前に内容を確認できます。"/>

                <TextBlock Text="種別" FontWeight="Bold" Margin="0,14,0,4"/>
                <ComboBox x:Name="ReportTypeComboBox" SelectedIndex="0" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem Content="不具合"/>
                    <ComboBoxItem Content="機能要望"/>
                </ComboBox>

                <TextBlock Text="概要" FontWeight="Bold" Margin="0,14,0,4"/>
                <TextBox x:Name="SummaryText" MinHeight="32" ToolTip="何が起きたかを短く入力してください"/>

                <TextBlock Text="再現手順" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="StepsText" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" ToolTip="不具合が起きるまでの操作を入力してください"/>

                <TextBlock Text="期待する動作" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="ExpectedText" MinHeight="55" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="実際の動作・エラーメッセージ" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBox x:Name="ActualText" MinHeight="75" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <CheckBox x:Name="IncludeLogCheckBox" Content="直近の操作ログをIssueに含める" IsChecked="True" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,0,14,14">
            <ui:Button Content="GitHubで報告" Icon="{ui:SymbolIcon Bug24}" Appearance="Primary"
                       Click="ReportButton_Click"/>
            <ui:Button Content="閉じる" Margin="8,0,0,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>