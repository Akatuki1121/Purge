<ui:FluentWindow x:Class="Purge.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Purge.UI"
        xmlns:loc="clr-namespace:Purge.UI.Localization"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Purge" Height="700" Width="1040" MinWidth="640" MinHeight="480"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="AppListItemStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="#243447"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F6FA"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFA"/>
                    <Setter Property="Foreground" Value="#173B63"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="#5B6878"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <!-- WPF-UIのAppearance="Danger"は背景赤に対し既定の文字色のコントラストが弱いため、
             白文字を明示して視認性を確保する。ResidueWindow/OrphanWindowの危険ボタンにも同じ対策を適用する。 -->
        <Style x:Key="DangerButtonReadable" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Danger"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="MainTitleBar" Grid.Row="0" Title="Purge" ShowMaximize="True" ShowMinimize="True" Margin="{StaticResource TitleBarResizeGapMargin}"/>

        <Border Grid.Row="1" Background="#F7F9FC" BorderBrush="#E3E8EF" BorderThickness="0,0,0,1"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" Orientation="Horizontal">
                    <ui:Button Content="{loc:Loc Btn_Reload}" Icon="{ui:SymbolIcon ArrowSync24}"
                               Click="RefreshButton_Click"/>
                    <ui:Button Content="{loc:Loc Btn_Feedback}" Icon="{ui:SymbolIcon Bug24}"
                               Margin="8,0,0,0" Click="ReportBugMenuItem_Click"/>
                    <ui:Button Content="{loc:Loc Btn_FindOrphans}" Icon="{ui:SymbolIcon Search24}"
                               Margin="8,0,0,0" Click="ScanOrphanButton_Click"
                               ToolTip="{loc:Loc Tip_FindOrphans}"/>
                </WrapPanel>
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0"
                           ToolTip="{loc:Loc Tip_ScanStatus}">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="15" Foreground="#6B7785"/>
                    <TextBlock x:Name="ScanStatusText" Text="{loc:Loc Scan_Idle}" Margin="6,0,8,0" Foreground="#6B7785"
                               FontSize="11" VerticalAlignment="Center"/>
                    <ui:Button x:Name="CancelScanButton" Content="{loc:Loc Btn_Cancel}" Appearance="Secondary"
                               Visibility="Collapsed" Click="CancelScanButton_Click"/>
                    <ui:Button x:Name="CheckUpdateButton" Content="{loc:Loc Btn_CheckUpdate}" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Margin="8,0,0,0" Click="CheckUpdateButton_Click"/>
                    <ui:Button x:Name="ProUpgradeButton" Content="{loc:Loc Btn_UpgradePro}" Appearance="Primary"
                               Icon="{ui:SymbolIcon Star24}" Margin="8,0,0,0" Click="ProUpgradeButton_Click"/>
                </WrapPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Menu Background="Transparent" Padding="4,0" VerticalAlignment="Center">
                        <MenuItem Header="{loc:Loc Menu_Language}">
                            <MenuItem x:Name="LanguageAutoMenuItem" Header="{loc:Loc Menu_LanguageAuto}" IsCheckable="True" Click="LanguageAutoMenuItem_Click"/>
                            <MenuItem x:Name="LanguageJapaneseMenuItem" Header="日本語" IsCheckable="True" Click="LanguageJapaneseMenuItem_Click"/>
                            <MenuItem x:Name="LanguageEnglishMenuItem" Header="English" IsCheckable="True" Click="LanguageEnglishMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                    <Menu Background="Transparent" Padding="4,0" VerticalAlignment="Center">
                        <MenuItem Header="{loc:Loc Menu_More}">
                            <MenuItem Header="{loc:Loc Menu_Restore}" Click="RestoreBackupMenuItem_Click"/>
                            <MenuItem Header="{loc:Loc Title_About}" Click="AboutMenuItem_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_SelfUninstall}" Click="SelfUninstallButton_Click"/>
                            <Separator/>
                            <MenuItem Header="{loc:Loc Menu_Exit}" Click="ExitMenuItem_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="ElevationWarningBorder" Grid.Row="2" Background="#FFF3CD" BorderBrush="#FFECB5"
                BorderThickness="1" Padding="8" Margin="10,4,10,0" Visibility="Collapsed">
            <TextBlock TextWrapping="Wrap" Foreground="#664D03"
                       Text="{loc:Loc Warn_NotAdmin}"/>
        </Border>

        <Border x:Name="UpdateAvailableBorder" Grid.Row="2" Background="#E7F1FF" BorderBrush="#B6D4FE"
                BorderThickness="1" Padding="8" Margin="10,4,10,0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateAvailableText" Grid.Column="0" TextWrapping="Wrap" Foreground="#0B3D91"
                           VerticalAlignment="Center"
                           Text="🔔 新しいバージョンがあります。"/>
                <ui:Button x:Name="UpdateDownloadButton" Grid.Column="1" Content="{loc:Loc Btn_Download}" Appearance="Primary"
                           Margin="8,0,0,0" Click="UpdateDownloadButton_Click"/>
                <ui:Button x:Name="UpdateDismissButton" Grid.Column="2" Content="{loc:Loc Btn_Later}" Appearance="Secondary"
                           Margin="8,0,0,0" Click="UpdateDismissButton_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="14,10,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:Loc Hdr_InstalledApps}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#6B7785"/>
            </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Background="#F5F7FA" BorderBrush="#D9E0E8" BorderThickness="1"
                        CornerRadius="5" Padding="10,0" Width="250" Height="34">
                    <Grid>
                        <TextBox x:Name="SearchTextBox" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="22,0,0,0"
                                 TextChanged="SearchTextBox_TextChanged" ToolTip="{loc:Loc Tip_Search}"/>
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" Foreground="#7A8795"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

                <ui:Card Grid.Row="4" Margin="14,0,14,10" Padding="0">
                    <Grid>
                        <ListView x:Name="AppListView" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                  ItemContainerStyle="{StaticResource AppListItemStyle}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView AllowsColumnReorder="True" ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                    <GridViewColumn Header="" Width="32">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="18" Height="18"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{loc:Loc Col_AppName}" Width="300" DisplayMemberBinding="{Binding DisplayName}"/>
                                    <GridViewColumn Header="{loc:Loc Col_Version}" Width="110" DisplayMemberBinding="{Binding DisplayVersion}"/>
                                    <GridViewColumn Header="{loc:Loc Col_Publisher}" Width="210" DisplayMemberBinding="{Binding PublisherDisplay}"/>
                                    <GridViewColumn Header="{loc:Loc Col_InstallLocation}" Width="220" DisplayMemberBinding="{Binding InstallLocation}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel x:Name="EmptyStatePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="Collapsed" IsHitTestVisible="False">
                            <ui:SymbolIcon x:Name="EmptyStateIcon" Symbol="Search24" FontSize="30"
                                           Foreground="#9AA7B5" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyStateText" Text="アプリが見つかりません" Foreground="#687586"
                                       FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
        </ui:Card>

        <ui:Card Grid.Row="5" Margin="14,0,14,8" Padding="16,14">
            <StackPanel>

                <!-- 通常操作: アンインストール(単体が基本、複数選択時のみ一括ボタンが現れる) -->
                <WrapPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,8,0" Foreground="#666"/>
                    <ui:ToggleSwitch x:Name="DryRunToggle" IsChecked="True"
                                      VerticalAlignment="Center" Checked="DryRunToggle_Changed" Unchecked="DryRunToggle_Changed"
                                      ToolTip="{loc:Loc Safe_Tooltip}"/>
                    <Border x:Name="DryRunStatusBadge" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                            Background="#E6F4EA" VerticalAlignment="Center">
                        <TextBlock x:Name="DryRunStatusText" Text="{loc:Loc Badge_Safe}"
                                   FontSize="11" FontWeight="Bold" Foreground="#1E7B34"/>
                    </Border>
                    <ui:Button x:Name="UninstallButton" Content="{loc:Loc Btn_Uninstall}"
                               Appearance="Primary" Icon="{ui:SymbolIcon Delete24}"
                               Margin="16,0,0,0" Click="UninstallButton_Click"/>
                    <ui:Button x:Name="BatchUninstallButton" Content="{loc:Loc Btn_BatchUninstallPro}"
                               Icon="{ui:SymbolIcon Apps24}" Margin="8,0,0,0" Click="BatchUninstallButton_Click"
                               Visibility="Collapsed"/>
                </WrapPanel>

            </StackPanel>
        </ui:Card>

        <Expander x:Name="LogExpander" Grid.Row="6" Margin="14,0,14,10" IsExpanded="False"
                  Background="#F7F9FC" BorderBrush="#DCE3EB" BorderThickness="1">
            <Expander.HeaderTemplate>
                <!-- HeaderTemplateの直下はExpanderの内部ContentPresenterがHorizontalContentAlignment=Stretch
                     で幅を渡してくれるため、旧実装(固定幅980や自己参照のWidthバインド)と違い
                     常に正しい幅で描画される。コピーボタンが見切れる不具合(Issue #28)の修正。 -->
                <DataTemplate>
                    <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Foreground="#657487"
                                       Margin="0,0,8,0"/>
                        <TextBlock Text="{loc:Loc Log_Title}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{loc:Loc Log_Subtitle}" Margin="10,0,0,0" Foreground="#8793A1"
                                   FontSize="11"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1" x:Name="CopyLogButton" Content="{loc:Loc Common_Copy}" Icon="{ui:SymbolIcon Copy24}"
                               FontSize="11" Padding="8,2" Click="CopyLogButton_Click"/>
                    </Grid>
                </DataTemplate>
            </Expander.HeaderTemplate>
            <Border Padding="14,0,14,12">
                <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap"
                             IsReadOnly="True" BorderThickness="0" Background="Transparent" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"/>
                </ScrollViewer>
            </Border>
        </Expander>
    </Grid>
</ui:FluentWindow>
