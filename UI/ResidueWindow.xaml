<ui:FluentWindow x:Class="UninstallTool.UI.ResidueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="残存物スキャン結果" Height="620" Width="920"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- WPF-UIのAppearance="Danger"は背景赤に対し既定の文字色のコントラストが弱いため、白文字を明示する -->
        <Style x:Key="DangerButtonReadable" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Danger"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="残存物スキャン結果"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,8">
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="(行をクリックして選択、Ctrl/Shiftで複数選択できます)" FontSize="11" Foreground="Gray"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
            <ui:Button x:Name="SelectAllButton" Content="全選択" Margin="16,0,0,0" Click="SelectAllButton_Click"/>
            <ui:Button x:Name="DeselectAllButton" Content="全解除" Margin="8,0,0,0" Click="DeselectAllButton_Click"/>
        </StackPanel>

        <ui:Card Grid.Row="2" Margin="14,0,14,10" Padding="0">
            <ListView x:Name="ResidueListView" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="種別" Width="120" DisplayMemberBinding="{Binding CategoryText}"/>
                        <GridViewColumn Header="確度" Width="60" DisplayMemberBinding="{Binding ConfidenceText}"/>
                        <GridViewColumn Header="場所" Width="500" DisplayMemberBinding="{Binding LocationText}"/>
                        <GridViewColumn Header="検出根拠" Width="300" DisplayMemberBinding="{Binding DetectionReasonText}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </ui:Card>

        <ui:Card Grid.Row="3" Margin="14,0,14,14" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="DryRunToggle" OnContent="ドライラン" OffContent="実際に削除" IsChecked="True"
                                  VerticalAlignment="Center" Checked="DryRunToggle_Changed" Unchecked="DryRunToggle_Changed"/>
                <Border x:Name="DryRunStatusBadge" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                        Background="#E6F4EA" VerticalAlignment="Center">
                    <TextBlock x:Name="DryRunStatusText" Text="✓ 安全モード(実際には削除されません)"
                               FontSize="11" FontWeight="Bold" Foreground="#1E7B34"/>
                </Border>
                <ui:Button x:Name="DeleteButton" Content="選択した項目を削除" Style="{StaticResource DangerButtonReadable}"
                           Icon="{ui:SymbolIcon Delete24}" Margin="16,0,0,0" Click="DeleteButton_Click"/>
                <ui:Button x:Name="ExportButton" Content="エクスポート(Pro)" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="12,0,0,0" Click="ExportButton_Click"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
