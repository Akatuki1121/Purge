<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Core\Purge.Core.csproj" />
    <PackageReference Include="WPF-UI" Version="4.0.0" />
    <None Include="..\THIRD_PARTY_LICENSES.md" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="Purge.UI.CHANGELOG.md" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Purgeはja/enのみ対応のため、.NETランタイム/WPFが同梱する他言語のsatellite
         リソース(十数言語分のフォルダ)を除外する。Publish出力のファイル数・サイズを
         削減し、MSI作成とインストール双方を高速化する(Issue #45)。 -->
    <SatelliteResourceLanguages>ja;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
