<ui:FluentWindow x:Class="UninstallTool.UI.OrphanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="対応アプリ不明フォルダのスキャン結果" Height="660" Width="960"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- WPF-UIのAppearance="Danger"は背景赤に対し既定の文字色のコントラストが弱いため、白文字を明示する -->
        <Style x:Key="DangerButtonReadable" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Danger"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="対応アプリ不明フォルダのスキャン結果(実験的機能)"/>

        <ui:InfoBar Grid.Row="1" Margin="14,10,14,8" IsOpen="True" IsClosable="False" Severity="Warning"
                    Title="削除前に必ず確認してください"
                    Message="どのアプリにも対応が確認できなかったフォルダの候補です。「最終更新」が最近のものは、まだ使われている可能性があるため注意してください。行をクリックして選択できます(Ctrl/Shiftで複数選択可)。"/>

        <ui:Card Grid.Row="2" Margin="14,0,14,10" Padding="0">
            <ListView x:Name="OrphanListView" SelectionMode="Extended" BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="フォルダ名" Width="180" DisplayMemberBinding="{Binding FolderName}"/>
                        <GridViewColumn Header="場所" Width="180" DisplayMemberBinding="{Binding LocationDescription}"/>
                        <GridViewColumn Header="サイズ" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                        <GridViewColumn Header="ファイル数" Width="80" DisplayMemberBinding="{Binding FileCountDisplay}"/>
                        <GridViewColumn Width="200">
                            <GridViewColumn.Header>
                                <TextBlock Text="最終更新"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastModifiedDisplay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksRecentlyUsed}" Value="True">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="フルパス" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </ui:Card>

        <ui:Card Grid.Row="3" Margin="14,0,14,14" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="DryRunToggle" OnContent="ドライラン" OffContent="実際に削除" IsChecked="True"
                                  VerticalAlignment="Center" Checked="DryRunToggle_Changed" Unchecked="DryRunToggle_Changed"/>
                <Border x:Name="DryRunStatusBadge" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                        Background="#E6F4EA" VerticalAlignment="Center">
                    <TextBlock x:Name="DryRunStatusText" Text="✓ 安全モード(実際には削除されません)"
                               FontSize="11" FontWeight="Bold" Foreground="#1E7B34"/>
                </Border>
                <ui:Button x:Name="OpenFolderButton" Content="選択項目をエクスプローラーで開く"
                           Icon="{ui:SymbolIcon FolderOpen24}" Margin="16,0,0,0" Click="OpenFolderButton_Click"/>
                <ui:Button x:Name="ExcludeButton" Content="今後表示しない"
                           Icon="{ui:SymbolIcon EyeOff24}" Margin="8,0,0,0" Click="ExcludeButton_Click"/>
                <ui:Button x:Name="DeleteButton" Content="選択した項目を削除" Style="{StaticResource DangerButtonReadable}"
                           Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                <ui:Button x:Name="ExportButton" Content="エクスポート(Pro)" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="8,0,0,0" Click="ExportButton_Click"/>
            </StackPanel>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
