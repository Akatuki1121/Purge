<ui:FluentWindow x:Class="Purge.UI.OrphanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:loc="clr-namespace:Purge.UI.Localization"
        mc:Ignorable="d"
        Title="{loc:Loc Win_Orphan}" Height="660" Width="960" MinWidth="620" MinHeight="420"
        Icon="app.ico"
        ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <!-- WPF-UIのAppearance="Danger"は背景赤に対し既定の文字色のコントラストが弱いため、白文字を明示する -->
        <Style x:Key="DangerButtonReadable" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Danger"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Loc Win_Orphan}" Margin="{StaticResource TitleBarResizeGapMargin}"/>

        <ui:InfoBar Grid.Row="1" Margin="14,10,14,8" IsOpen="True" IsClosable="False" Severity="Warning"
                    Title="{loc:Loc Orphan_InfoTitle}"
                    Message="{loc:Loc Orphan_InfoMessage}"/>

        <ui:Card Grid.Row="2" Margin="14,0,14,10" Padding="0">
            <ListView x:Name="OrphanListView" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{loc:Loc Col_FolderName}" Width="180" DisplayMemberBinding="{Binding FolderName}"/>
                        <GridViewColumn Header="{loc:Loc Col_Location}" Width="180" DisplayMemberBinding="{Binding LocationDescription}"/>
                        <GridViewColumn Header="{loc:Loc Col_Size}" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
                        <GridViewColumn Header="{loc:Loc Col_FileCount}" Width="80" DisplayMemberBinding="{Binding FileCountDisplay}"/>
                        <GridViewColumn Width="200">
                            <GridViewColumn.Header>
                                <TextBlock Text="{loc:Loc Col_LastModified}"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastModifiedDisplay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LooksRecentlyUsed}" Value="True">
                                                        <Setter Property="Foreground" Value="#B45309"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{loc:Loc Col_FullPath}" Width="260" DisplayMemberBinding="{Binding FullPath}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </ui:Card>

        <ui:Card Grid.Row="3" Margin="14,0,14,14" Padding="14,10">
            <WrapPanel Orientation="Horizontal">
                <ui:ToggleSwitch x:Name="DryRunToggle" OnContent="{loc:Loc Safe_On}" OffContent="{loc:Loc Safe_Off}" IsChecked="True"
                                  VerticalAlignment="Center" Checked="DryRunToggle_Changed" Unchecked="DryRunToggle_Changed"
                                  ToolTip="{loc:Loc Safe_Tooltip}"/>
                <Border x:Name="DryRunStatusBadge" Margin="10,0,0,0" Padding="8,3" CornerRadius="4"
                        Background="#E6F4EA" VerticalAlignment="Center">
                    <TextBlock x:Name="DryRunStatusText" Text="{loc:Loc Badge_Safe}"
                               FontSize="11" FontWeight="Bold" Foreground="#1E7B34"/>
                </Border>
                <ui:Button x:Name="OpenFolderButton" Content="{loc:Loc Btn_OpenInExplorer}"
                           Icon="{ui:SymbolIcon FolderOpen24}" Margin="16,0,0,0" Click="OpenFolderButton_Click"/>
                <ui:Button x:Name="ExcludeButton" Content="{loc:Loc Btn_ExcludeForever}"
                           Icon="{ui:SymbolIcon EyeOff24}" Margin="8,0,0,0" Click="ExcludeButton_Click"/>
                <ui:Button x:Name="DeleteButton" Content="{loc:Loc Btn_DeleteSelected}" Style="{StaticResource DangerButtonReadable}"
                           Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Click="DeleteButton_Click"/>
                <ui:Button x:Name="ExportButton" Content="{loc:Loc Btn_ExportPro}" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="8,0,0,0" Click="ExportButton_Click"/>
            </WrapPanel>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
